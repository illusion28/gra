<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Eeveelutions Rollover Gallery</title>
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      background-color: #0b0f19;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      color: #f8fafc;
      padding: 3rem 1.5rem;
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    /* Top Section / Header */
    .header {
      max-width: 780px;
      text-align: center;
      margin-bottom: 3.5rem;
    }

    .header h1 {
      font-size: clamp(2rem, 5vw, 3rem);
      font-weight: 800;
      letter-spacing: -0.5px;
      margin-bottom: 0.75rem;
      background: linear-gradient(135deg, #f59e0b, #ec4899, #38bdf8);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .header p {
      font-size: 1.1rem;
      color: #94a3b8;
      line-height: 1.6;
    }

    /* 9-Card Responsive Grid */
    .grid-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: 1.75rem;
      width: 100%;
      max-width: 1100px;
    }

    /* Card Box */
    .hover-card {
      position: relative;
      height: 280px;
      background-color: #161f30;
      border: 2px solid #283548;
      border-radius: 18px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      overflow: hidden;
      transition: transform 0.35s ease, border-color 0.35s ease, box-shadow 0.35s ease;
    }

    .hover-card:hover {
      transform: translateY(-6px);
    }

    /* Initial Display (Name & Subtitle) */
    .card-placeholder {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
      transition: opacity 0.3s ease, transform 0.3s ease;
      pointer-events: none;
    }

    .poke-name {
      font-size: 1.35rem;
      font-weight: 700;
      color: #f1f5f9;
    }

    .hover-hint {
      font-size: 0.85rem;
      text-transform: uppercase;
      letter-spacing: 1px;
      color: #64748b;
    }

    /* Hide placeholder on hover */
    .hover-card:hover .card-placeholder {
      opacity: 0;
      transform: scale(0.85);
    }

    /* SVG Hidden by Default */
    .reveal-svg {
      position: absolute;
      top: 32px;
      width: 64px;
      height: 64px;
      opacity: 0;
      visibility: hidden;
      transform: scale(0.6) rotate(-10deg);
      transition: opacity 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                  transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
                  visibility 0.35s;
      pointer-events: none;
    }

    /* Reveal SVG on Hover */
    .hover-card:hover .reveal-svg {
      opacity: 1;
      visibility: visible;
      transform: scale(1) rotate(0deg);
    }

    /* Info Tooltip / Description Box */
    .info-box {
      position: absolute;
      bottom: -100%;
      left: 0;
      width: 100%;
      background: rgba(11, 15, 25, 0.95);
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      padding: 1.1rem;
      text-align: center;
      backdrop-filter: blur(8px);
      transition: bottom 0.4s cubic-bezier(0.16, 1, 0.3, 1);
      pointer-events: none;
    }

    .info-box h3 {
      font-size: 0.95rem;
      font-weight: 700;
      margin-bottom: 0.3rem;
    }

    .info-box p {
      font-size: 0.82rem;
      color: #cbd5e1;
      line-height: 1.4;
    }

    /* Slide Up Info Box on Hover */
    .hover-card:hover .info-box {
      bottom: 0;
    }

    /* -------------------------------------------
       ELEMENTAL COLOR THEMES & ACCENTS
    -------------------------------------------- */
    /* EEVEE (Normal) */
    .card-eevee:hover { border-color: #c08a53; box-shadow: 0 10px 30px rgba(192, 138, 83, 0.25); }
    .card-eevee .reveal-svg { stroke: #c08a53; }
    .card-eevee .info-box h3 { color: #c08a53; }

    /* VAPOREON (Water) */
    .card-vaporeon:hover { border-color: #38bdf8; box-shadow: 0 10px 30px rgba(56, 189, 248, 0.25); }
    .card-vaporeon .reveal-svg { stroke: #38bdf8; }
    .card-vaporeon .info-box h3 { color: #38bdf8; }

    /* JOLTEON (Electric) */
    .card-jolteon:hover { border-color: #facc15; box-shadow: 0 10px 30px rgba(250, 204, 21, 0.25); }
    .card-jolteon .reveal-svg { stroke: #facc15; }
    .card-jolteon .info-box h3 { color: #facc15; }

    /* FLAREON (Fire) */
    .card-flareon:hover { border-color: #f97316; box-shadow: 0 10px 30px rgba(249, 115, 22, 0.25); }
    .card-flareon .reveal-svg { stroke: #f97316; }
    .card-flareon .info-box h3 { color: #f97316; }

    /* ESPEON (Psychic) */
    .card-espeon:hover { border-color: #c084fc; box-shadow: 0 10px 30px rgba(192, 132, 252, 0.25); }
    .card-espeon .reveal-svg { stroke: #c084fc; }
    .card-espeon .info-box h3 { color: #c084fc; }

    /* UMBREON (Dark) */
    .card-umbreon:hover { border-color: #fbbf24; box-shadow: 0 10px 30px rgba(251, 191, 36, 0.25); }
    .card-umbreon .reveal-svg { stroke: #fbbf24; }
    .card-umbreon .info-box h3 { color: #fbbf24; }

    /* LEAFEON (Grass) */
    .card-leafeon:hover { border-color: #4ade80; box-shadow: 0 10px 30px rgba(74, 222, 128, 0.25); }
    .card-leafeon .reveal-svg { stroke: #4ade80; }
    .card-leafeon .info-box h3 { color: #4ade80; }

    /* GLACEON (Ice) */
    .card-glaceon:hover { border-color: #67e8f9; box-shadow: 0 10px 30px rgba(103, 232, 249, 0.25); }
    .card-glaceon .reveal-svg { stroke: #67e8f9; }
    .card-glaceon .info-box h3 { color: #67e8f9; }

    /* SYLVEON (Fairy) */
    .card-sylveon:hover { border-color: #f472b6; box-shadow: 0 10px 30px rgba(244, 114, 182, 0.25); }
    .card-sylveon .reveal-svg { stroke: #f472b6; }
    .card-sylveon .info-box h3 { color: #f472b6; }
  </style>
</head>
<body>

  <!-- Top Informational Section -->
  <header class="header">
    <h1>The Eeveelutions</h1>
    <p>
      Eevee is celebrated as the Evolution Pokémon due to its unstable genetic makeup, allowing it to adapt to its surroundings and evolve into eight distinct elemental forms. Roll over any card below to reveal its elemental seal and combat ability.
    </p>
  </header>

  <!-- Gallery Grid -->
  <main class="grid-container">

    <!-- 1. Eevee -->
    <div class="hover-card card-eevee">
      <div class="card-placeholder">
        <span class="poke-name">Eevee</span>
        <span class="hover-hint">Normal Type</span>
      </div>
      <!-- DNA / Adaptability Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="8" stroke-dasharray="2 4"/>
        <path d="M12 2v4M12 18v4M2 12h4M18 12h4"/>
      </svg>
      <div class="info-box">
        <h3>Eevee (Normal)</h3>
        <p>Possesses an unstable genetic structure that allows it to evolve into eight different forms.</p>
      </div>
    </div>

    <!-- 2. Vaporeon -->
    <div class="hover-card card-vaporeon">
      <div class="card-placeholder">
        <span class="poke-name">Vaporeon</span>
        <span class="hover-hint">Water Type</span>
      </div>
      <!-- Water Droplet Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linejoin="round">
        <path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/>
      </svg>
      <div class="info-box">
        <h3>Vaporeon (Water)</h3>
        <p>Can melt into water at will by altering its cell structure to become invisible in aquatic environments.</p>
      </div>
    </div>

    <!-- 3. Jolteon -->
    <div class="hover-card card-jolteon">
      <div class="card-placeholder">
        <span class="poke-name">Jolteon</span>
        <span class="hover-hint">Electric Type</span>
      </div>
      <!-- Lightning Bolt Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linejoin="round">
        <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>
      </svg>
      <div class="info-box">
        <h3>Jolteon (Electric)</h3>
        <p>Generates negative ions in its fur to launch 10,000-volt lightning bolts and fire needle-sharp fur.</p>
      </div>
    </div>

    <!-- 4. Flareon -->
    <div class="hover-card card-flareon">
      <div class="card-placeholder">
        <span class="poke-name">Flareon</span>
        <span class="hover-hint">Fire Type</span>
      </div>
      <!-- Flame Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linejoin="round">
        <path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>
      </svg>
      <div class="info-box">
        <h3>Flareon (Fire)</h3>
        <p>Stores flame inside an internal flame sac, expelling fire that reaches over 3,000°F.</p>
      </div>
    </div>

    <!-- 5. Espeon -->
    <div class="hover-card card-espeon">
      <div class="card-placeholder">
        <span class="poke-name">Espeon</span>
        <span class="hover-hint">Psychic Type</span>
      </div>
      <!-- Psychic Eye / Forehead Gem Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="3"/>
        <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z"/>
      </svg>
      <div class="info-box">
        <h3>Espeon (Psychic)</h3>
        <p>Reads air currents with its velvet coat to predict weather conditions and an opponent's next move.</p>
      </div>
    </div>

    <!-- 6. Umbreon -->
    <div class="hover-card card-umbreon">
      <div class="card-placeholder">
        <span class="poke-name">Umbreon</span>
        <span class="hover-hint">Dark Type</span>
      </div>
      <!-- Crescent Moon Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linejoin="round">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
      <div class="info-box">
        <h3>Umbreon (Dark)</h3>
        <p>Hunts silently in the dark. The circular yellow rings across its body glow when excited or bathed in moonlight.</p>
      </div>
    </div>

    <!-- 7. Leafeon -->
    <div class="hover-card card-leafeon">
      <div class="card-placeholder">
        <span class="poke-name">Leafeon</span>
        <span class="hover-hint">Grass Type</span>
      </div>
      <!-- Leaf Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/>
        <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/>
      </svg>
      <div class="info-box">
        <h3>Leafeon (Grass)</h3>
        <p>Undergoes photosynthesis just like a plant, producing crisp, clean oxygen wherever it sleeps.</p>
      </div>
    </div>

    <!-- 8. Glaceon -->
    <div class="hover-card card-glaceon">
      <div class="card-placeholder">
        <span class="poke-name">Glaceon</span>
        <span class="hover-hint">Ice Type</span>
      </div>
      <!-- Snowflake / Ice Crystal Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <path d="M12 2v20M2 12h20M4.93 4.93l14.14 14.14M4.93 19.07l14.14-14.14"/>
        <circle cx="12" cy="12" r="2"/>
      </svg>
      <div class="info-box">
        <h3>Glaceon (Ice)</h3>
        <p>Instantly freezes its body moisture into diamond-dust icicles that it can launch at incoming foes.</p>
      </div>
    </div>

    <!-- 9. Sylveon -->
    <div class="hover-card card-sylveon">
      <div class="card-placeholder">
        <span class="poke-name">Sylveon</span>
        <span class="hover-hint">Fairy Type</span>
      </div>
      <!-- Ribbon / Sparkle Fairy Icon -->
      <svg class="reveal-svg" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
        <path d="M12 3l1.91 5.89L20 9.24l-4.55 4.43 1.07 6.25L12 17l-4.52 2.92 1.07-6.25L4 9.24l6.09-.35L12 3z"/>
      </svg>
      <div class="info-box">
        <h3>Sylveon (Fairy)</h3>
        <p>Wraps its ribbon-like feelers around trainers to emit a soothing aura that neutralizes hostility.</p>
      </div>
    </div>

  </main>

</body>
</html>
